# ---- Engine ----
PORT=8080
# ROOT SECRET for provable fairness. Every brand's every daily seed is HMAC-SHA256(MASTER_SEED,
# "site:<siteId>:day:<date>"), so this one value determines every trade outcome and every published
# fairness commitment. Anyone who learns it can predict outcomes and forge commitments — treat it
# like a signing key: generate it once, store it only in the host's secret store, never commit it,
# and do not rotate it casually (already-revealed days must stay re-derivable).
#   generate: openssl rand -hex 32
# The engine REFUSES TO BOOT when DATABASE_URL is set and this is missing, a known dev placeholder,
# or shorter than 32 characters — a real deployment must never silently fall back to a weak seed.
MASTER_SEED=
# LEGACY FALLBACK, used only when MASTER_SEED is unset (same meaning, same requirements). Set
# MASTER_SEED instead; this is kept so existing deployments keep deriving identical seeds.
SERVER_SEED=

# ---- Persistence (Postgres / Supabase) ----
# When set, the engine uses the atomic RPCs (fn_open_position / fn_settle_position)
# via the service-role connection. When unset, it runs an in-memory store (dev only).
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/postgres

# ---- Auth (self-issued HS256 tokens; verified on the socket and REST) ----
# Auth is self-managed (phone + password, no OTP/Supabase Auth). The API's AuthService SIGNS
# HS256 tokens with SUPABASE_JWT_SECRET and the engine/API verify with the same secret.
# REQUIRED for apps/api (token issuance) and whenever DATABASE_URL is set (fail-closed).
SUPABASE_JWT_SECRET=
# Asymmetric JWKS verification (engine WS only) — cannot verify the API's self-issued HS256
# tokens, so set SUPABASE_JWT_SECRET when running apps/api:
SUPABASE_JWKS_URL=
# Optional issuer/audience pinning (must match on both the issuer and the verifier):
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUD=authenticated

# ---- API security hardening (apps/api) ----
# Verify STK deposit callbacks against Safaricom (STKPushQuery) before crediting, so a forged
# POST to the public callback URL can't mint balance. Default ON; set "false" only if the
# callback source is otherwise trusted (e.g. a strict IP allowlist below).
MPESA_VERIFY_CALLBACKS=true
# Lock the Daraja callback endpoints (STK deposit callback, C2B validation/confirmation, B2C
# withdrawal and affiliate-payout results) to Safaricom's published source IPs — comma-separated
# IPv4 CIDRs. `restrictToCidrs` in apps/api/src/http.ts is DISABLED when this is unset, so leaving
# it empty publishes those endpoints to the whole internet: a forged POST then races the real
# callback to settle a withdrawal/payout or (where STKPushQuery verification is off) credit a
# deposit. Shipped populated for that reason — shorten it only if Safaricom narrows the ranges.
MPESA_CALLBACK_ALLOWED_CIDRS=196.201.212.0/24,196.201.213.0/24,196.201.214.0/24
# Rate limits (requests per minute). Auth is per source IP; payments are per user.
RATE_LIMIT_AUTH_PER_MIN=40
RATE_LIMIT_PAYMENTS_PER_MIN=20
# Deposit reconciliation sweep interval (ms). Settles deposits whose STK callback never arrived
# or whose verification was inconclusive, using Safaricom's STKPushQuery. 0 disables.
DEPOSIT_RECONCILE_INTERVAL_MS=300000
# MFA endpoint rate limit (requests per minute, per user).
RATE_LIMIT_MFA_PER_MIN=10
# Browser origins allowed to call this API (comma-separated). UNSET DEFAULTS TO `*`, which echoes
# any request Origin — tolerable only because auth is a Bearer token and never a cookie, but it
# also means any page on the internet can script the API against a token it has stolen. Naming the
# origins is the defence-in-depth setting; it does NOT have to list brand domains, because once
# this is restricted (not `*`) the router additionally allows every ACTIVE brand domain from the
# `sites` table (apps/api/src/http.ts) plus any `*.<suffix>` preview entries (apps/api/src/cors.ts),
# so onboarding a brand still needs no redeploy. Left commented on purpose: an EMPTY value is not
# the same as unset — it parses to an empty allowlist, so only brand domains are allowed and a
# localhost dev front-end is blocked. Uncomment and name your origins in production:
# CORS_ALLOWED_ORIGINS=https://cpfmarket.com,https://*.invest254.pages.dev

# ---- Password reset (interim, pre-OTP) ----
# DANGER: allows setting a new password from a phone number alone, with no possession proof.
# That is account takeover by design (anyone who knows a player's number can seize their wallet),
# so it is DISABLED unless set to exactly "true". Replace with an OTP-verified flow before relying
# on it in production. The authenticated /auth/password/change route is always available and safe.
ALLOW_UNVERIFIED_PASSWORD_RESET=false
# Password-reset attempts per minute, per source IP.
RATE_LIMIT_RESET_PER_MIN=5

# ---- Real-money payout alerts & approvals (Issue 1) ----
# Player M-Pesa withdrawals and marketer COMMISSION payouts are real money: they require the
# superadmin's account password to APPROVE (on every surface — dashboard, Telegram, email). Reject
# only returns funds and is not gated. Demo/"funny money" marketer game->wallet transfers are INSTANT
# and never appear on these channels (migration 0109).
#
# Telegram bot channel: instant Approve/Reject with password-gated approval.
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram USER ids allowed to act on payouts (in a group these are member user ids).
TELEGRAM_CHAT_IDS=
# Shared secret echoed by Telegram in X-Telegram-Bot-Api-Secret-Token; gates the webhook.
TELEGRAM_WEBHOOK_SECRET=
# Optional: a forum-enabled GROUP id so records self-organise into status topic tabs. When set, alerts
# post to the "Waiting" topic and settled records are mirrored into the Approved/Rejected topics.
TELEGRAM_FORUM_CHAT_ID=
TELEGRAM_TOPIC_WAITING=
TELEGRAM_TOPIC_APPROVED=
TELEGRAM_TOPIC_REJECTED=
# Email alert channel (login-free). Withdrawal emails carry one-tap Approve/Reject links (the Approve
# confirm page is password-gated). Dormant unless all three are set.
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_ALERT_EMAILS=
# Optional: pin which admin profile id is recorded as the approver/rejecter for link/bot actions.
WITHDRAWAL_ACTION_ADMIN_ID=

# ---- Payment-gateway configuration (migration 0130) ----
# Deposit-gateway credentials (Mega Pay / Paystack / Binance Pay / PayHero) can be configured from the
# superadmin console (/platform/config -> Gateway configuration) and are stored ENCRYPTED in Postgres.
# This 32-byte key (base64 or hex) encrypts those secrets with AES-256-GCM in the engine before they
# reach the DB, so a DB dump alone can't reveal a credential. REQUIRED before saving any gateway secret.
#   generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PAYMENTS_CONFIG_ENC_KEY=
# Mega Pay env fallback (used when no DB config row exists — keeps the current production behaviour):
MEGAPAY_ENV=sandbox
MEGAPAY_API_KEY=
MEGAPAY_EMAIL=
# MEGAPAY_API_BASE=https://megapay.co.ke/backend/v2
# MEGAPAY_CALLBACK_ALLOWED_CIDRS=

# ---- Domain provisioning: registrar (Namecheap) — OPTIONAL ----
# When these are set, onboarding auto-points a new domain's nameservers at Cloudflare. When absent,
# Cloudflare (zone+DNS+Pages+SSL) still provisions and the console shows the nameservers to set by hand.
# NAMECHEAP_CLIENT_IP MUST be the PUBLIC egress IP of the API server (whitelisted in the Namecheap
# dashboard under Profile -> Tools -> API Access -> Whitelisted IPs). For Fly, that's the app egress IP.
NAMECHEAP_API_KEY=
NAMECHEAP_API_USER=
NAMECHEAP_USERNAME=
NAMECHEAP_CLIENT_IP=
